# Example settings only. Supply credentials through your private runtime environment.
NETSCOPE_DEPLOYMENT_MODE=protected
NETSCOPE_BACKEND_HOST=0.0.0.0
NETSCOPE_BACKEND_PORT=8787
# Set after configuring and validating a real HTTPS ingress.
NETSCOPE_TLS_TERMINATED=1
NETSCOPE_API_KEY=
NETSCOPE_UPSTREAM_CHAT_URL=
NETSCOPE_CLIENT_TOKEN=
NETSCOPE_ALLOWED_MODELS=qwen-plus
NETSCOPE_MAX_TOTAL_REQUESTS=30
# One process/replica with a persistent private volume.
NETSCOPE_QUOTA_FILE=/var/lib/netscope/quota.json
NETSCOPE_TRACE_LOG=/var/lib/netscope/requests.jsonl
